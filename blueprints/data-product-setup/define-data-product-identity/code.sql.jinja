{%- set valid_orders = ['<domain>_<env>_<dataproduct>', '<domain>_<dataproduct>_<env>', '<env>_<domain>_<dataproduct>'] %}
{%- set order = object_component_order if object_component_order is defined and object_component_order in valid_orders else '<domain>_<dataproduct>_<env>' %}
{%- set strategy = account_strategy if account_strategy is defined else 'Single Account' %}
{%- set parts = [] %}
{%- for component in order.split('_') %}
{%- set token = component[1:-1] %}
{%- if token == 'domain' and strategy not in ['Multi-Account (Domain-based)', 'Multi-Account (Domain + Environment)'] %}{%- if parts.append(data_product_domain | upper) %}{% endif %}
{%- elif token == 'env' and strategy not in ['Multi-Account (Environment-based)', 'Multi-Account (Domain + Environment)'] %}{%- if parts.append(data_product_environment | upper) %}{% endif %}
{%- elif token == 'dataproduct' %}{%- if parts.append(data_product_name | upper) %}{% endif %}
{%- endif %}
{%- endfor %}
{%- set prefix = parts | join('_') %}
-- ============================================================================
-- DATA PRODUCT IDENTITY
-- ============================================================================
-- Data Product: {{ data_product_name }}
-- Domain: {{ data_product_domain }}
-- Environment: {{ data_product_environment }}
-- SCIM Prefix: {{ scim_prefix }}
-- Account Strategy: {{ account_strategy }}
{%- if account_strategy != 'Single Account' %}
-- Target Account: {{ target_account_name | upper }}
{%- endif %}
-- ============================================================================
-- This step captures identity information for planning purposes.
-- No SQL is executed in this step.
-- ============================================================================

/*
DATA PRODUCT IDENTITY DEFINED
=============================

Core Identity:
- Name: {{ data_product_name }}
- Domain: {{ data_product_domain }}
- Environment: {{ data_product_environment }}
- Description: {{ data_product_description }}

SCIM Configuration:
{%- if scim_prefix | upper != 'NONE' %}
- SCIM Enabled: Yes
- SCIM Prefix: {{ scim_prefix | upper }}
- Role Owner: {{ scim_prefix | upper }}_PROVISIONER
- User Assignment: Via identity provider groups
{%- else %}
- SCIM Enabled: No
- Role Owner: USERADMIN
- User Assignment: Manual GRANT statements
{%- endif %}

Naming Components (based on {{ account_strategy }}):
- Prefix: {{ prefix }}
- Example: {{ prefix }}_RAW

Core Roles to be Created:
- {{ prefix }}_ADMIN  (owns infrastructure)
- {{ prefix }}_CREATE (creates objects)
- {{ prefix }}_WRITE  (modifies data)
- {{ prefix }}_RBAC   (owns access roles)
- {{ prefix }}_READ   (read-only access)

Cost Allocation Tags:
- DOMAIN = '{{ data_product_domain | upper }}'
- ENVIRONMENT = '{{ data_product_environment | upper }}'
- DATAPRODUCT = '{{ data_product_name | upper }}'
*/

-- ============================================================================
-- VERIFICATION: Check SCIM Configuration (optional)
-- ============================================================================
-- Run these queries to verify your SCIM setup before proceeding

{%- if scim_prefix | upper != 'NONE' %}

-- Verify SCIM provisioner role exists
SHOW ROLES LIKE '{{ scim_prefix | upper }}_PROVISIONER';

-- Check SCIM security integration
SHOW SECURITY INTEGRATIONS LIKE '%{{ scim_prefix | upper }}%';

{%- else %}

-- No SCIM - verify USERADMIN is available
USE ROLE USERADMIN;
SELECT 'USERADMIN access verified' AS status;

{%- endif %}
