{%- set account_strategy = account_strategy if account_strategy is defined else 'Single Account' %}
-- ============================================================================
-- CREATE RESOURCE MONITORS
-- ============================================================================
-- Data Product: {{ data_product_name }}
{%- if account_strategy != 'Single Account' %}
-- Target Account: {{ target_account_name | upper }}
{%- endif %}
-- ============================================================================
-- EXECUTE FROM: {% if account_strategy != 'Single Account' %}{{ target_account_name | upper }}{% else %}Primary Account{% endif %}
-- REQUIRED ROLE: ACCOUNTADMIN (to create resource monitors)
-- ============================================================================

-- Derive the data product prefix for object names
{%- set valid_orders = ['<domain>_<env>_<dataproduct>', '<domain>_<dataproduct>_<env>', '<env>_<domain>_<dataproduct>'] %}
{%- set order = object_component_order if object_component_order is defined and object_component_order in valid_orders else '<domain>_<dataproduct>_<env>' %}
{%- set strategy = account_strategy if account_strategy is defined else 'Single Account' %}
{%- set parts = [] %}
{%- for component in order.split('_') %}
{%- set token = component[1:-1] %}
{%- if token == 'domain' and strategy not in ['Multi-Account (Domain-based)', 'Multi-Account (Domain + Environment)'] %}{%- if parts.append(data_product_domain | upper) %}{% endif %}
{%- elif token == 'env' and strategy not in ['Multi-Account (Environment-based)', 'Multi-Account (Domain + Environment)'] %}{%- if parts.append(data_product_environment | upper) %}{% endif %}
{%- elif token == 'dataproduct' %}{%- if parts.append(data_product_name | upper) %}{% endif %}
{%- endif %}
{%- endfor %}
{%- set prefix = parts | join('_') %}

-- Resource monitors require ACCOUNTADMIN
USE ROLE ACCOUNTADMIN;

-- ============================================================================
-- CREATE RESOURCE MONITOR
-- ============================================================================

CREATE RESOURCE MONITOR IF NOT EXISTS {{ prefix }}_MONITOR
  WITH
    CREDIT_QUOTA = {{ resource_monitor_credits }}
    FREQUENCY = {{ resource_monitor_frequency }}
    START_TIMESTAMP = IMMEDIATELY
    -- Notification thresholds
    TRIGGERS
      ON 50 PERCENT DO NOTIFY
      ON 75 PERCENT DO NOTIFY
      ON 90 PERCENT DO NOTIFY
      ON 100 PERCENT DO SUSPEND;

-- ============================================================================
-- VERIFICATION
-- ============================================================================

-- Verify resource monitor
SHOW RESOURCE MONITORS LIKE '{{ prefix }}_MONITOR';

/*
RESOURCE MONITOR CREATED
========================

Monitor: {{ prefix }}_MONITOR
Credit Quota: {{ resource_monitor_credits }} credits
Frequency: {{ resource_monitor_frequency }}

Thresholds:
  - 50% → Notify
  - 75% → Notify
  - 90% → Notify
  - 100% → Suspend

NEXT STEPS:
- Step 5.2: Assign monitor to warehouses
- Step 5.3: Configure alert notifications
*/
