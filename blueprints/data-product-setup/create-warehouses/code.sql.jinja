{%- set account_strategy = account_strategy if account_strategy is defined else 'Single Account' %}
{%- set valid_orders = ['<domain>_<env>_<dataproduct>', '<domain>_<dataproduct>_<env>', '<env>_<domain>_<dataproduct>'] %}
{%- set order = object_component_order if object_component_order is defined and object_component_order in valid_orders else '<domain>_<dataproduct>_<env>' %}
{%- set strategy = account_strategy if account_strategy is defined else 'Single Account' %}
{%- set parts = [] %}
{%- for component in order.split('_') %}
{%- set token = component[1:-1] %}
{%- if token == 'domain' and strategy not in ['Multi-Account (Domain-based)', 'Multi-Account (Domain + Environment)'] %}{%- if parts.append(data_product_domain | upper) %}{% endif %}
{%- elif token == 'env' and strategy not in ['Multi-Account (Environment-based)', 'Multi-Account (Domain + Environment)'] %}{%- if parts.append(data_product_environment | upper) %}{% endif %}
{%- elif token == 'dataproduct' %}{%- if parts.append(data_product_name | upper) %}{% endif %}
{%- endif %}
{%- endfor %}
{%- set prefix = parts | join('_') %}

-- ============================================================================
-- CREATE WAREHOUSES
-- ============================================================================
-- Data Product: {{ data_product_name }}
{%- if account_strategy != 'Single Account' %}
-- Target Account: {{ target_account_name | upper }}
{%- endif %}
-- ============================================================================
-- EXECUTE FROM: {% if account_strategy != 'Single Account' %}{{ target_account_name | upper }}{% else %}Primary Account{% endif %}
-- REQUIRED ROLE: SECURITYADMIN (grants CREATE WAREHOUSE), {{ prefix }}_CREATE (creates warehouses)
-- ============================================================================

-- GRANT CREATE WAREHOUSE TO CREATE ROLE
USE ROLE SECURITYADMIN;
GRANT CREATE WAREHOUSE ON ACCOUNT TO ROLE {{ prefix }}_CREATE;

-- Use the CREATE role (CREATE WAREHOUSE privilege granted above)
USE ROLE {{ prefix }}_CREATE;

-- ============================================================================
-- CREATE WAREHOUSES
-- ============================================================================
{% for wh in warehouse_configuration %}
{%- set wh_name = prefix ~ '_WH_' ~ wh.name | upper %}

-- ----------------------------------------------------------------------------
-- WAREHOUSE: {{ wh_name }}
-- ----------------------------------------------------------------------------

CREATE WAREHOUSE IF NOT EXISTS {{ wh_name }}
  WITH
    WAREHOUSE_SIZE = '{{ wh.size }}'
    MIN_CLUSTER_COUNT = {{ wh.min_cluster_count }}
    MAX_CLUSTER_COUNT = {{ wh.max_cluster_count }}
    SCALING_POLICY = 'STANDARD'
    AUTO_SUSPEND = {{ wh.auto_suspend_seconds }}
    AUTO_RESUME = TRUE
{%- if wh.timeout_minutes is defined and wh.timeout_minutes is not none and (wh.timeout_minutes | float) > 0 %}
    STATEMENT_TIMEOUT_IN_SECONDS = {{ [[(([(wh.timeout_minutes | float), 10080] | min) * 60) | round | int, 1] | max, 604800] | min }}
{%- endif %}
    INITIALLY_SUSPENDED = TRUE
    ENABLE_QUERY_ACCELERATION = FALSE
    COMMENT = '{{ wh.name }} warehouse for {{ data_product_name }} data product';

-- Apply governance tags
ALTER WAREHOUSE {{ wh_name }} SET TAG
    {{ platform_database_name }}.{{ governance_name }}.DOMAIN = '{{ data_product_domain | upper }}',
    {{ platform_database_name }}.{{ governance_name }}.ENVIRONMENT = '{{ data_product_environment | upper }}',
    {{ platform_database_name }}.{{ governance_name }}.DATAPRODUCT = '{{ data_product_name }}',
    {{ platform_database_name }}.{{ governance_name }}.WORKLOAD = '{{ wh.name | upper }}';

{% endfor %}

-- ============================================================================
-- TRANSFER OWNERSHIP TO ADMIN
-- ============================================================================

-- Switch to SECURITYADMIN to perform ownership transfer
USE ROLE SECURITYADMIN;

{% for wh in warehouse_configuration %}
{%- set wh_name = prefix ~ '_WH_' ~ wh.name | upper %}
GRANT OWNERSHIP ON WAREHOUSE {{ wh_name }} TO ROLE {{ prefix }}_ADMIN COPY CURRENT GRANTS;
{% endfor %}

-- ============================================================================
-- VERIFICATION
-- ============================================================================

USE ROLE {{ prefix }}_ADMIN;

-- Show all warehouses
SHOW WAREHOUSES LIKE '{{ prefix }}_WH_%';

-- Verify tags are applied
{% for wh in warehouse_configuration %}
{%- set wh_name = prefix ~ '_WH_' ~ wh.name | upper %}
SELECT SYSTEM$GET_TAG('{{ platform_database_name }}.{{ governance_name }}.DATAPRODUCT', '{{ wh_name }}', 'WAREHOUSE') AS tag_value;
{% endfor %}

/*
WAREHOUSES CREATED
==================

Created {{ warehouse_configuration | length }} warehouse(s) for {{ data_product_name }} data product:

{%- for wh in warehouse_configuration %}
{%- set wh_name = prefix ~ '_WH_' ~ wh.name | upper %}
  {{ loop.index }}. {{ wh_name }}
     Size: {{ wh.size }}
     Clusters: {{ wh.min_cluster_count }}-{{ wh.max_cluster_count }}
     Auto-suspend: {{ wh.auto_suspend_seconds }}s
{%- endfor %}

Warehouse Ownership: {{ prefix }}_ADMIN

NEXT STEPS:
- Step 3.2: Create warehouse access roles
- Step 3.3: Wire up role hierarchy
*/
