{%- set fg_name = dr_failover_group_name | default('DR') %}
-- ============================================================================
-- STEP: Pre-Drill Validation
-- ============================================================================
-- Verify replication is healthy before executing a DR drill
-- ============================================================================

USE ROLE ACCOUNTADMIN;

-- ----------------------------------------------------------------------------
-- Confirm Failover Groups Exist
-- ----------------------------------------------------------------------------
SHOW FAILOVER GROUPS;

-- ----------------------------------------------------------------------------
-- Check Replication Lag
-- ----------------------------------------------------------------------------
SELECT PHASE_NAME, START_TIME, END_TIME,
       DATEDIFF('minute', END_TIME, CURRENT_TIMESTAMP()) AS MINUTES_BEHIND
FROM TABLE(INFORMATION_SCHEMA.REPLICATION_GROUP_REFRESH_HISTORY('{{ fg_name }}'))
ORDER BY END_TIME DESC LIMIT 1;

-- ----------------------------------------------------------------------------
-- Check for In-Flight Refresh
-- ----------------------------------------------------------------------------
SELECT PHASE_NAME, START_TIME, PROGRESS
FROM TABLE(INFORMATION_SCHEMA.REPLICATION_GROUP_REFRESH_PROGRESS('{{ fg_name }}'));

-- ============================================================================
-- VERIFICATION
-- ============================================================================
-- If MINUTES_BEHIND exceeds RPO target, wait for next refresh before proceeding
SELECT CURRENT_TIMESTAMP() AS DRILL_START_TIMESTAMP;
